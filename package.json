{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist/server",
    "build:netlify": "npm run build:client",
    "preview": "cross-env NODE_ENV=production node server.js",
    "lint": "eslint .",
    "compress:images": "node compress-assets.js",
    "compress:video": "node compress-video.js",
    "check:large-files": "node check-large-files.js",
    "generate:sitemap": "node scripts/generate-sitemap.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.75.0",
    "@tanstack/react-query": "^5.24.1",
    "framer-motion": "^12.23.24",
    "i18next": "^23.10.1",
    "i18next-browser-languagedetector": "^7.2.0",
    "i18next-http-backend": "^4.0.10",
    "leaflet": "^1.9.4",
    "lodash": "^4.17.21",
    "lucide-react": "^0.344.0",
    "qs": "^6.14.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^14.1.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.18.5",
    "react-turnstile": "^1.1.4",
    "zustand": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^8.56.0",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.21",
    "@types/lodash": "^4.14.202",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.58",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.18",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "express": "^4.18.2",
    "globals": "^13.24.0",
    "postcss": "^8.4.35",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.4.6"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
